@{
    ViewData["Title"] = "Order Confirmation";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm border-0">
                <div class="card-body text-center p-5">
                    <div class="mb-4">
                        <i class="bi bi-check-circle-fill text-success" style="font-size: 4rem;"></i>
                    </div>
                    
                    <h2 class="card-title mb-3" style="color: #4F46E5;">Order Successfully Placed!</h2>
                    
                    <p class="text-muted mb-4">
                        Thank you for shopping with us. Your order has been confirmed and will be processed shortly.
                    </p>

                    <div class="alert alert-light border mb-4">
                        <div class="d-flex flex-column gap-2">
                            <!-- <div>
                                <i class="bi bi-envelope me-2"></i>
                                A confirmation email will be sent to your registered email address.
                            </div> -->
                            <div>
                                <i class="bi bi-box me-2"></i>
                                You can track your order status in the "My Orders" section.
                            </div>
                            <div>
                                <i class="bi bi-clock-history me-2"></i>
                                Expected processing time: 1-2 business days
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-center gap-3">
                        <a href="/Home/Index" class="btn btn-outline-primary">
                            <i class="bi bi-house me-2"></i>Back to Home
                        </a>
                        <a href="/UserOrder/UserOrders" class="btn btn-primary">
                            <i class="bi bi-bag me-2"></i>View My Orders
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

