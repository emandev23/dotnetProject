<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>EBookStore - Online book store</title>
    <link href="/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.3.0/font/bootstrap-icons.css">
    <link href="~/BookShoppingCartMvcUI.styles.css" rel="stylesheet" />
</head>
<body>
    <nav class="navbar navbar-expand-lg shadow-sm" style="background-color: #FFFFFF;">
        <div class="container-fluid">
            <a class="navbar-brand" href="/Home/Index" style="color: #4F46E5; font-weight: 600;">EBookStore</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarColor01" aria-controls="navbarColor01" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarColor01">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="/Home/Index" style="color: #111827;">
                            Home
                        </a>
                    </li>
                    @if (User.IsInRole(Roles.Admin.ToString()))
                    {
                        <li class="nav-item">
                            <a class="nav-link" href="/AdminOperations/Dashboard" style="color: #111827;">Dashboard</a>
                        </li>
                    }
                </ul>
                <partial name="_LoginPartial" />
            </div>
        </div>
    </nav>
    <div class="container">
        <div class="my-2">
            <partial name="_Notifications" />
        </div>
        @RenderBody()
    </div>

    <footer class="footer mt-5">
        <div class="container py-4">
            <div class="row g-4">
                <div class="col-lg-4 col-md-6">
                    <h5 class="mb-3" style="color: #4F46E5;">EBookStore</h5>
                    <p class="text-muted">Your one-stop destination for digital and physical books. Discover millions of eBooks, textbooks, and audiobooks.</p>
                </div>
                
                <div class="col-lg-2 col-md-6">
                    <h6 class="mb-3">Quick Links</h6>
                    <ul class="list-unstyled">
                        <li><a href="/Home/Index" class="footer-link">Home</a></li>
                        <li><a href="/Cart/GetUserCart" class="footer-link">My Cart</a></li>
                        <li><a href="/UserOrder/UserOrders" class="footer-link">My Orders</a></li>
                        <li><a href="#" class="footer-link">About Us</a></li>
                    </ul>
                </div>
                
                <div class="col-lg-2 col-md-6">
                    <h6 class="mb-3">Categories</h6>
                    <ul class="list-unstyled">
                        <li><a href="#" class="footer-link">Fiction</a></li>
                        <li><a href="#" class="footer-link">Non-Fiction</a></li>
                        <li><a href="#" class="footer-link">Educational</a></li>
                        <li><a href="#" class="footer-link">Children's Books</a></li>
                    </ul>
                </div>
                
                <div class="col-lg-4 col-md-6">
                    <h6 class="mb-3">Contact Us</h6>
                    <ul class="list-unstyled">
                        <li class="mb-2">
                            <i class="bi bi-geo-alt text-muted me-2"></i>
                            123 Book Street, Casablanca City, 12345
                        </li>
                        <li class="mb-2">
                            <i class="bi bi-envelope text-muted me-2"></i>
                            contact@ebookstore.com
                        </li>
                        <li class="mb-2">
                            <i class="bi bi-telephone text-muted me-2"></i>
                            +212 6 12 34 56 78
                        </li>
                    </ul>
                </div>
            </div>
        </div>
        <div class="footer-bottom py-3" style="background: rgba(79, 70, 229, 0.08); border-top: 1px solid rgba(79, 70, 229, 0.1);">
            <div class="container">
                <div class="row align-items-center">
                    <div class="col-md-6 text-center text-md-start">
                        <p class="mb-0 text-muted">&copy; @DateTime.Now.Year EBookStore. All rights reserved.</p>
                    </div>
                    <div class="col-md-6 text-center text-md-end mt-3 mt-md-0">
                        <a href="#" class="text-muted me-3">Privacy Policy</a>
                        <a href="#" class="text-muted me-3">Terms of Service</a>
                        <a href="#" class="text-muted">Cookie Policy</a>
                    </div>
                </div>
            </div>
        </div>
    </footer>
</body>
<script src="https://code.jquery.com/jquery-3.7.1.min.js" integrity="sha256-/JqT3SQfawRcv/BIHPThkBvs0OEvtFFmqPF/lYI/Cxo=" crossorigin="anonymous"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js" integrity="sha384-MrcW6ZMFYlzcLA8Nl+NtUVF0sA7MsXsP1UyJoMp4YLEuNSfAP+JcXn/tWtIaxVXM" crossorigin="anonymous"></script>
@await RenderSectionAsync("Scripts", required: false)
<script>
    // Update cart count on page load
    document.addEventListener('DOMContentLoaded', async function() {
        const usernameEl = document.getElementById("username");
        if (usernameEl) {  // Only fetch cart count if user is logged in
            try {
                const response = await fetch('/Cart/GetTotalItemInCart');
                if (response.ok) {
                    const count = await response.json();
                    const cartCountEl = document.getElementById("cartCount");
                    if (cartCountEl) {
                        cartCountEl.innerHTML = count;
                    }
                }
            } catch (err) {
                console.error('Error fetching cart count:', err);
            }
        }
    });
</script>
</html>

