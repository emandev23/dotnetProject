@model BookDisplayModel
@{

}
<div class="my-2">
    <form asp-action="Index" class="row row-cols-lg-auto g-3 align-items-center">
        <div class="col-12">
            <label class="visually-hidden" for="genreId">Genres</label>
            <select class="form-select" id="genreId" name="genreId">
                <option selected>Genre</option>
                @foreach (var genre in Model.Genres)
                {
                    <option selected="@(genre.Id == Model.GenreId)" value="@genre.Id">@genre.GenreName</option>
                }
            </select>
        </div>

        <div class="col-12">
            <label class="visually-hidden" for="sterm">Search by title</label>
            <div class="input-group">
                <div class="input-group-text"><i class="bi bi-search"></i></div>
                <input type="text" class="form-control" value="@Model.STerm" id="sterm" name="sterm" placeholder="Search by title">
            </div>
        </div>

        <div class="col-12">
            <button type="submit" class="btn btn-primary">Search</button>
            <a href="/Home/Index" class="btn btn-secondary">Reset</a>
        </div>
    </form>
</div>

<div class="w-100 mt-4">
    @if (Model.Books != null && Model.Books.Any())
    {
        <div class="d-flex flex-wrap gap-4 justify-content-center">
            @foreach (var book in Model.Books)
            {
        <div class="card" style="width: 16rem;">
            @if (string.IsNullOrEmpty(book.Image))
            {
                <img style="width:100%;height:240px;object-fit:contain;background-color:#F3F4F6" src="/images/NoImage.svg" class="card-img-top" alt="No book cover available">
            }
            else
            {
                <img style="width:100%;height:240px;object-fit:cover" src="/images/@book.Image" class="card-img-top" alt="...">
            }
            <div class="card-body">
                <h5 class="card-title text-truncate">@book.BookName</h5>
                <p class="card-text">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="text-muted">Genre</span>
                        <span>@book.GenreName</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="text-muted">Author</span>
                        <span>@book.AuthorName</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="text-muted">Price</span>
                        <span class="fw-bold">MAD @book.Price.ToString("F2")</span>
                    </div>
                </p>
                @if (book.Quantity > 0)
                {
                    <button type="button" onclick="add(@book.Id)" class="btn btn-primary w-100">
                        <i class="bi bi-cart-plus me-2"></i>Add to cart
                    </button>
                }
                else
                {
                    <div class="text-danger text-center py-2 border border-danger rounded">
                        <i class="bi bi-exclamation-circle me-2"></i>Out of stock
                    </div>
                }
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <img src="/images/NoResults.svg" alt="No results found" style="max-width: 400px; width: 100%; height: auto;" />
            @if (!string.IsNullOrEmpty(Model.STerm) || Model.GenreId > 0)
            {
                <div class="mt-4">
                    <a href="/Home/Index" class="btn btn-primary">
                        <i class="bi bi-arrow-left me-2"></i>Back to All Books
                    </a>
                </div>
            }
        </div>
    }
</div>

@section Scripts{
    <script>
        async function add(bookId) {
            var usernameEl = document.getElementById("username");
            if(usernameEl==null){
                window.location.href = "/Identity/Account/Login";
            }
            try {
                var response = await fetch(`/Cart/AddItem?bookId=${bookId}`);
                if (response.status == 200) {
                    var result = await response.json();
                    var cartCountEl = document.getElementById("cartCount");
                    cartCountEl.innerHTML = result;
                    window.location.href = "#cartCount";
                }
            }
            catch (err) {
                console.log(err);
            }
        }
    </script>
}


